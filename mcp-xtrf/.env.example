# Base URL of your XTRF instance, no trailing slash
XTRF_BASE_URL=https://xtrf.amidas.si

# Path prefix for the API, appended to XTRF_BASE_URL before every request.
# Amidas uses the XTRF Home API (see https://xtrf.amidas.si/api-doc#/home-api/).
XTRF_API_BASE_PATH=/home-api/v2

# Authentication mode: "apikey" (default, static token), "classic_login", or "oauth2"
XTRF_AUTH_MODE=apikey

# --- apikey mode (default) ---
# Static token sent on every request. Generate it in XTRF under your user's
# API key settings, or wherever https://xtrf.amidas.si/api-doc#/home-api/
# documents obtaining one.
XTRF_API_KEY=
# Header the token is sent in.
XTRF_API_KEY_HEADER=Authorization
# Prepended to XTRF_API_KEY when building the header value, e.g. "Bearer <token>".
# Set to empty string if the API expects the raw token with no prefix.
XTRF_API_KEY_PREFIX=Bearer

# --- classic_login mode (XTRF Classic REST API v2 session login) ---
# Logs in with username/password against XTRF_LOGIN_URL and reuses the
# returned session token on subsequent requests until it expires.
XTRF_USERNAME=
XTRF_PASSWORD=
# Defaults to {XTRF_BASE_URL}{XTRF_API_BASE_PATH}/session - override if different.
XTRF_LOGIN_URL=
XTRF_SESSION_HEADER=X-AUTH-ACCESS-TOKEN
XTRF_SESSION_TOKEN_FIELD=id

# --- oauth2 mode (client_credentials grant) ---
XTRF_CLIENT_ID=
XTRF_CLIENT_SECRET=
XTRF_TOKEN_URL=
