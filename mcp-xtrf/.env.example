# Base URL of your XTRF instance, no trailing slash
XTRF_BASE_URL=https://xtrf.amidas.si

# Path prefix for the API, appended to XTRF_BASE_URL before every request.
# Common values: /home-api/v2 (XTRF Home REST API v2) or /api/v2 (legacy REST API).
# Check your instance's API docs (usually linked from the XTRF admin panel) to confirm.
XTRF_API_BASE_PATH=/home-api/v2

# Authentication mode: "apikey" or "oauth2"
XTRF_AUTH_MODE=apikey

# --- apikey mode ---
# Static key/token sent on every request.
XTRF_API_KEY=
# Header name the key is sent under. XTRF Home API commonly expects "X-API-KEY";
# some legacy setups use "X-AUTH-ACCESS-TOKEN". Confirm against your docs.
XTRF_API_KEY_HEADER=X-API-KEY

# --- oauth2 mode (client_credentials grant) ---
XTRF_CLIENT_ID=
XTRF_CLIENT_SECRET=
# Full URL of the token endpoint, e.g. https://xtrf.amidas.si/home-api/v2/oauth/token
XTRF_TOKEN_URL=
