# Base URL of your XTRF instance, no trailing slash
XTRF_BASE_URL=https://xtrf.amidas.si

# Path prefix for the API, appended to XTRF_BASE_URL before every request.
# Amidas uses the XTRF Home API (see https://xtrf.amidas.si/api-doc#/home-api/),
# e.g. GET https://xtrf.amidas.si/home-api/projects/86652.
XTRF_API_BASE_PATH=/home-api

# Accept header for responses. XTRF Home API uses a versioned vendor type
# instead of plain application/json - confirm the version (v1, v2, ...)
# against /api-doc if you see unexpected 406/415 errors.
XTRF_ACCEPT_HEADER=application/vnd.xtrf-v1+json;charset=UTF-8

# Content-Type header for request bodies (POST/PUT/PATCH). Per the OpenAPI
# spec this is plain JSON, not the versioned Accept media type above.
XTRF_CONTENT_TYPE_HEADER=application/json;charset=UTF-8

# Authentication mode: "apikey" (default, static token), "classic_login", or "oauth2"
XTRF_AUTH_MODE=apikey

# --- apikey mode (default) ---
# Static token sent on every request, per the "X-AUTH-ACCESS-TOKEN (apiKey)"
# authorization documented at https://xtrf.amidas.si/api-doc#/home-api/.
XTRF_API_KEY=
# Header the token is sent in.
XTRF_API_KEY_HEADER=X-AUTH-ACCESS-TOKEN
# Prepended to XTRF_API_KEY when building the header value. Left empty since
# the docs show the raw token value with no prefix (e.g. no "Bearer ").
XTRF_API_KEY_PREFIX=

# --- classic_login mode (XTRF Classic REST API v2 session login) ---
# Logs in with username/password against XTRF_LOGIN_URL and reuses the
# returned session token on subsequent requests until it expires.
XTRF_USERNAME=
XTRF_PASSWORD=
# Defaults to {XTRF_BASE_URL}{XTRF_API_BASE_PATH}/session - override if different.
XTRF_LOGIN_URL=
XTRF_SESSION_HEADER=X-AUTH-ACCESS-TOKEN
XTRF_SESSION_TOKEN_FIELD=id

# --- oauth2 mode (client_credentials grant) ---
XTRF_CLIENT_ID=
XTRF_CLIENT_SECRET=
XTRF_TOKEN_URL=
