# Base URL of your XTRF instance, no trailing slash
XTRF_BASE_URL=https://xtrf.amidas.si

# Path prefix for the API, appended to XTRF_BASE_URL before every request.
# Default below is for XTRF Classic REST API v2. If your instance uses the
# newer "Home" API instead, this is typically /home-api/v2 - check your
# instance's API documentation to confirm.
XTRF_API_BASE_PATH=/rest/v2

# Authentication mode: "classic_login" (XTRF Classic, default), "apikey", or "oauth2"
XTRF_AUTH_MODE=classic_login

# --- classic_login mode (XTRF Classic REST API v2) ---
# Logs in with username/password against XTRF_LOGIN_URL and reuses the
# returned session token on subsequent requests until it expires.
XTRF_USERNAME=
XTRF_PASSWORD=
# Defaults to {XTRF_BASE_URL}{XTRF_API_BASE_PATH}/session - override if different.
XTRF_LOGIN_URL=
# Header the session token is sent under on every request (and where it's
# first looked for in the login response). Confirm against your API docs.
XTRF_SESSION_HEADER=X-AUTH-ACCESS-TOKEN
# If the token isn't in the response header, it's read from this JSON body field instead.
XTRF_SESSION_TOKEN_FIELD=id

# --- apikey mode ---
# Static key/token sent on every request.
XTRF_API_KEY=
XTRF_API_KEY_HEADER=X-API-KEY

# --- oauth2 mode (client_credentials grant) ---
XTRF_CLIENT_ID=
XTRF_CLIENT_SECRET=
# Full URL of the token endpoint, e.g. https://xtrf.amidas.si/home-api/v2/oauth/token
XTRF_TOKEN_URL=
