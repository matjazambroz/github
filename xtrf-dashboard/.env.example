# Base URL of your XTRF instance, no trailing slash
XTRF_BASE_URL=https://xtrf.amidas.si

# Path prefix for the API, appended to XTRF_BASE_URL before every request.
XTRF_API_BASE_PATH=/home-api

# Static API token sent in header X-AUTH-ACCESS-TOKEN (no "Bearer " prefix).
XTRF_API_KEY=

# IANA time zone used to compute "midnight today" for date filters.
XTRF_TIMEZONE=Europe/Ljubljana

# How often to refresh the numbers, in minutes.
REFRESH_MINUTES=15

# How often to refresh YTD turnover, in minutes (checks every invoice issued
# this year, so it's slower - kept on its own, less frequent cycle).
YTD_REFRESH_MINUTES=60

# Local port for the dashboard web server.
PORT=4173
